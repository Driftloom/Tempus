{
  "manifest_version": 3,
  "name": "TEMPUS",
  "version": "0.1.0",
  "description": "Enterprise-grade personal intelligence layer",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/side-panel/main.html"
  },
  "omnibox": {
    "keyword": "t"
  },
  "action": {}
}
