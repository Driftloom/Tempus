# Database (Required)
DATABASE_URL=postgresql+asyncpg://tempus:tempus_password@localhost:5432/tempus
DATABASE_SSL_MODE=require  # disable, allow, prefer, require, verify-ca, verify-full
DATABASE_SSL_ROOT_CERT=/path/to/root.crt  # For verify-ca and verify-full

# Redis (Required)
REDIS_URL=redis://localhost:6379

# LLM Providers
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Security (Required - generate strong secrets)
JWT_SECRET=your-jwt-secret-key-min-32-characters-change-this
ENCRYPTION_KEY=your-encryption-key-min-32-characters-change-this

# CORS (Required - comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# OAuth2
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/callback/google

OUTLOOK_OAUTH_CLIENT_ID=your-outlook-client-id
OUTLOOK_OAUTH_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/callback/outlook

# Application
TEMPUS_ENV=development
LOG_LEVEL=INFO
